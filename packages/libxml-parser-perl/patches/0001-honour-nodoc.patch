Description: honour nodoc in override_dh_installexamples
 Under nodoc, dh_installexamples and dh_installdocs install nothing, and the
 commands that post-process the installed files then fail on paths that
 don't exist. Run them only when docs are built. A normal build is unchanged.
Author: Yohane Linux Maintainers <aqours@koiren.ai>
Forwarded: not-needed

--- a/debian/rules	2026-11-24 06:48:20.735473855 +0000
+++ b/debian/rules	2026-11-24 06:48:20.735473855 +0000
@@ -30,7 +30,9 @@
 
 override_dh_installexamples:
 	dh_installexamples
+ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
 	sed -i -e'1s|/usr/local/bin/perl|/usr/bin/perl|' $(EG)/canonical $(EG)/xmlcomments $(EG)/xmlstats $(EG)/xmlfilter
+endif
 
 # install Encodings/README and Encodings/*.msg as documentation
 override_dh_install:
