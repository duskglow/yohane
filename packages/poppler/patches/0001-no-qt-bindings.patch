--- a/debian/rules	2026-11-24 06:36:05.797628484 +0000
+++ b/debian/rules	2026-11-24 06:36:05.797628484 +0000
@@ -19,7 +19,7 @@
 	-DCMAKE_C_FLAGS_RELEASE="$(CFLAGS)"	\
 	-DCMAKE_CXX_FLAGS_RELEASE="$(CXXFLAGS)"	\
