Description: Yohane bootstrap: build dracut without its manual pages (no asciidoc)
 asciidoc-base is dropped from the build dependencies during the bootstrap (decisions 16 and 24).
 configure --disable-documentation skips the asciidoc/xsltproc step, and debian/dracut-core.manpages
 goes because there are no pages to install. See packages/dracut/README.md.
Author: Yohane Linux Maintainers <aqours@koiren.ai>
Forwarded: not-needed
---
--- a/debian/dracut-core.manpages	2025-04-11 09:17:09.000000000 +0000
+++ b/debian/dracut-core.manpages	1970-01-01 00:00:00.000000000 +0000
@@ -1 +0,0 @@
-usr/share/man/man?/*
--- a/debian/rules	2025-04-11 09:17:09.000000000 +0000
+++ b/debian/rules	2026-11-26 15:34:34.982993190 +0000
@@ -18,7 +18,7 @@
 	dh $@
 
 override_dh_auto_configure:
-	dh_auto_configure -- --systemdsystemunitdir=/$(deb_systemdsystemunitdir) --libdir=/usr/lib
+	dh_auto_configure -- --systemdsystemunitdir=/$(deb_systemdsystemunitdir) --libdir=/usr/lib --disable-documentation
 	$(SHELL) debian/fix-revdate
 	mv dracut-version.sh dracut-version.sh.orig
 	echo '#!/bin/sh' > dracut-version.sh
