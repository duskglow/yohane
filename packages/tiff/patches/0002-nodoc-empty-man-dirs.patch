Description: let dh_install find the man directories under nodoc
 The man pages are generated by sphinx, a <!nodoc> build dependency, but
 libtiff-dev.install and libtiff-tools.install name usr/share/man/man3 and
 usr/share/man/man1, so dh_install fails on missing files under nodoc.
 Create the empty directories first under nodoc. A normal build is unchanged.
Author: Yohane Linux Maintainers <aqours@koiren.ai>
Forwarded: not-needed

--- a/debian/rules	2026-11-24 09:36:22.989390687 +0000
+++ b/debian/rules	2026-11-24 09:36:22.989390687 +0000
@@ -26,6 +26,10 @@
 	dh_auto_test --max-parallel=1
 
 override_dh_install:
+ifneq (,$(filter nodoc,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
+	# the man pages come from sphinx, which nodoc drops; the .install files still name their directories
+	mkdir -p debian/tmp/usr/share/man/man1 debian/tmp/usr/share/man/man3
+endif
 	dh_install -X.la
 	# tiffgt is in libtiff-opengl so libtiff-tools doesn't have to have
 	# all the X and opengl dependencies.
