#!/bin/bash
# mkchroot: build an sbuild chroot tarball, unprivileged.
#
#   tools/mkchroot [--mirror URL] [--keyrings DIR] [--suite SUITE]
#                  [--debian URL --debian-security URL] OUTPUT.tar.zst
#
# Default: a Devuan excalibur chroot.
#
# With --debian and --debian-security, the build environment is Debian trixie
# with Devuan excalibur layered over it (design decision 11, "build like
# Debian, ship like Devuan"):
#   - excalibur (Origin: Devuan) is pinned to 600, so any package Devuan has,
#     including its forks, comes from Devuan;
#   - trixie (Origin: Debian) stays at 500, so packages Devuan dropped, such as
#     systemd's build-time pieces, still resolve as they do on Debian's buildds;
#   - the dpkg vendor is Debian, as it was for the Debian builds of these
#     packages, so vendor checks behave as on Debian.
#
# With --niji-swap VERSION --yohane-repo URL (stage 1, decision 12), libniji's
# system flavour at VERSION replaces glibc in the chroot, with throwaway glibc
# headers; see tools/niji-swap.sh. Its log is printed at the end.
#
# With --yohane-only SUITE --yohane-repo URL (stage 2 and later; design section
# 4, "no host tools"), every binary in the chroot comes from Yohane's own
# archive: SUITE (bootstrap for stage 2, unstable for stage 3), niji (libniji's
# libc6 family, with its own headers) and imported (the Architecture: all and
# ELF-free binaries Yohane imports, tools/mkimported). Devuan and Debian appear
# only as deb-src lines, so sbuild can fetch sources; none of their binaries can
# be installed. --debian is still needed for those deb-src lines.
#
# Uses mmdebstrap --mode=unshare (no root). Each mirror is trusted only through
# its signed InRelease, checked against the pinned keyrings in --keyrings DIR;
# never [trusted=yes]. The keyrings are also installed in the chroot so that
# apt inside it checks the same signatures.
set -euo pipefail

MIRROR=${YOHANE_MIRROR:-}
DEBIAN=${YOHANE_DEBIAN_MIRROR:-}
DEBSEC=${YOHANE_DEBIAN_SECURITY_MIRROR:-}
# The keyrings must be readable by the unshare namespace's mapped root, which
# can't enter a mode-750 home directory, so keep them outside $HOME.
KEYRINGS=${YOHANE_KEYRINGS:-}
SUITE=excalibur
DSUITE=trixie
while [ $# -gt 1 ]; do
  case "$1" in
    --mirror) MIRROR=$2; shift 2;;
    --keyrings) KEYRINGS=$2; shift 2;;
    --suite) SUITE=$2; shift 2;;
    --debian) DEBIAN=$2; shift 2;;
    --debian-security) DEBSEC=$2; shift 2;;
    --debian-suite) DSUITE=$2; shift 2;;
    --niji-swap|--liella-swap) NIJI_VERSION=$2; shift 2;;   # stage 1: swap libniji's system flavour in (decision 12); --liella-swap is the old name
    --yohane-repo) YOHANE_REPO=$2; shift 2;;      # where the "niji" suite is served
    --yohane-only) YOHANE_ONLY=$2; shift 2;;      # stage 2+: binaries only from Yohane's archive (this suite + niji + imported)
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
OUT=${1:?usage: mkchroot [--mirror URL] [--keyrings DIR] [--suite S] [--debian URL --debian-security URL] OUTPUT.tar.zst}
[ -n "$MIRROR" ] || { echo "mkchroot: set --mirror or YOHANE_MIRROR (the Devuan mirror base URL)" >&2; exit 2; }
[ -n "$KEYRINGS" ] || { echo "mkchroot: set --keyrings or YOHANE_KEYRINGS (directory of pinned archive keyrings)" >&2; exit 2; }
KR="$KEYRINGS/devuan-archive-keyring.gpg"
DKR="$KEYRINGS/debian-archive-keyring.gpg"
[ -r "$KR" ] || { echo "mkchroot: missing $KR" >&2; exit 2; }
if [ -n "$DEBIAN" ] || [ -n "$DEBSEC" ]; then
  [ -n "$DEBIAN" ] && [ -n "$DEBSEC" ] || { echo "mkchroot: --debian needs --debian-security too" >&2; exit 2; }
  [ -r "$DKR" ] || { echo "mkchroot: missing $DKR" >&2; exit 2; }
fi

SOURCES="deb $MIRROR $SUITE main
deb $MIRROR $SUITE-updates main
deb $MIRROR $SUITE-security main
deb-src $MIRROR $SUITE main
deb-src $MIRROR $SUITE-updates main
deb-src $MIRROR $SUITE-security main"

hooks=(--customize-hook="mkdir -p \"\$1/etc/apt/trusted.gpg.d\"" --customize-hook="copy-in $KR /etc/apt/trusted.gpg.d/")
keyring=(--keyring="$KR")
if [ -n "$DEBIAN" ]; then
  SOURCES+="
deb $DEBIAN $DSUITE main
deb $DEBIAN $DSUITE-updates main
deb $DEBSEC $DSUITE-security main"
  PREFS="Package: *
Pin: release o=Devuan
Pin-Priority: 600

Package: *
Pin: release o=Debian
Pin-Priority: 500

Package: src:rustc-web
Pin: version *
Pin-Priority: -1"
  # rustc-web is Debian's second Rust toolchain (for the browsers' security updates). It satisfies rustc's and
  # cargo's build dependencies and then conflicts with rustc, so building rustc fails to resolve; never use it.
  # The preferences must exist before mmdebstrap's first apt run, so a setup hook writes them.
  hooks=(--setup-hook="mkdir -p \"\$1/etc/apt/preferences.d\" && printf '%s\n' '$PREFS' > \"\$1/etc/apt/preferences.d/yohane-overlay\""
         "${hooks[@]}"
         --customize-hook="copy-in $DKR /etc/apt/trusted.gpg.d/"
         --customize-hook='ln -sfn debian "$1/etc/dpkg/origins/default"')
  keyring=(--keyring="$KEYRINGS")
fi

if [ -n "${NIJI_VERSION:-}" ]; then
  # Stage 1 (decision 12): libniji's system flavour replaces glibc in the chroot. See tools/niji-swap.sh.
  AKR="$KEYRINGS/yohane-archive-keyring.gpg"
  [ -n "${YOHANE_REPO:-}" ] || { echo "mkchroot: --niji-swap needs --yohane-repo URL" >&2; exit 2; }
  [ -r "$AKR" ] || { echo "mkchroot: missing $AKR" >&2; exit 2; }
  hooks+=(--customize-hook="copy-in $AKR /etc/apt/trusted.gpg.d/"
          --customize-hook="upload $(cd "$(dirname "$0")" && pwd)/niji-swap.sh /tmp/yohane-niji-swap.sh"
          --customize-hook="chroot \"\$1\" sh /tmp/yohane-niji-swap.sh '$NIJI_VERSION' '$YOHANE_REPO'"
          --customize-hook='rm -f "$1/tmp/yohane-niji-swap.sh"; cat "$1/var/log/yohane-niji-swap.log" >&2')
fi

if [ -n "${YOHANE_ONLY:-}" ]; then
  # Stage 2+ (design section 4): binaries only from Yohane's archive. Replaces the sources and hooks set up above.
  AKR="$KEYRINGS/yohane-archive-keyring.gpg"
  [ -z "${NIJI_VERSION:-}" ] || { echo "mkchroot: --yohane-only and --niji-swap don't mix" >&2; exit 2; }
  [ -n "${YOHANE_REPO:-}" ] || { echo "mkchroot: --yohane-only needs --yohane-repo URL" >&2; exit 2; }
  [ -n "$DEBIAN" ] || { echo "mkchroot: --yohane-only needs --debian and --debian-security (for deb-src)" >&2; exit 2; }
  [ -r "$AKR" ] || { echo "mkchroot: missing $AKR" >&2; exit 2; }
  SOURCES="deb $YOHANE_REPO $YOHANE_ONLY main
deb $YOHANE_REPO niji main
deb $YOHANE_REPO imported main"
  for s in "$SUITE" "$SUITE-updates" "$SUITE-security"; do SOURCES+="
deb-src $MIRROR $s main"; done
  SOURCES+="
deb-src $DEBIAN $DSUITE main
deb-src $DEBIAN $DSUITE-updates main
deb-src $DEBSEC $DSUITE-security main"
  # deb-src is resolved Devuan first, as stage 1 resolves sources.
  PREFS="Package: *
Pin: release o=Devuan
Pin-Priority: 600"
  hooks=(--setup-hook="mkdir -p \"\$1/etc/apt/preferences.d\" && printf '%s\n' '$PREFS' > \"\$1/etc/apt/preferences.d/yohane-overlay\""
         --customize-hook="mkdir -p \"\$1/etc/apt/trusted.gpg.d\""
         --customize-hook="copy-in $AKR $KR $DKR /etc/apt/trusted.gpg.d/"
         --customize-hook='ln -sfn debian "$1/etc/dpkg/origins/default"'
         # Gate (tools/yohane-only-gate.sh): every installed binary must come from Yohane's archive.
         --customize-hook="upload $(cd "$(dirname "$0")" && pwd)/yohane-only-gate.sh /tmp/yohane-only-gate.sh"
         --customize-hook="chroot \"\$1\" sh /tmp/yohane-only-gate.sh '$YOHANE_REPO'"
         --customize-hook='rm -f "$1/tmp/yohane-only-gate.sh"')
  keyring=(--keyring="$KEYRINGS")
  SUITE=$YOHANE_ONLY
fi

case "$OUT" in *.tar.zst) ;; *) echo "mkchroot: OUTPUT must end in .tar.zst" >&2; exit 2;; esac
mkdir -p "$(dirname "$OUT")"
tmp="${OUT%.tar.zst}.tmp$$.tar.zst"
trap 'rm -f "$tmp"' EXIT

# Sources come on stdin (the "-" mirror argument); the output format follows
# from the file extension.
mmdebstrap --mode=unshare --variant=buildd \
  "${keyring[@]}" \
  --include=ca-certificates \
  "${hooks[@]}" \
  --customize-hook='rm -f "$1"/var/cache/apt/*.bin; rm -rf "$1"/var/lib/apt/lists/*' \
  "$SUITE" "$tmp" - <<<"$SOURCES"

mv -f "$tmp" "$OUT"
trap - EXIT
echo "mkchroot: wrote $OUT ($(du -h "$OUT" | cut -f1))"
