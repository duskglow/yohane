#!/bin/bash
# buildone: build one source package on this build host and report the result.
#
#   tools/buildone STAGE SOURCE VERSION
#
# Runs sbuild (unshare mode, through the host's `slots` queue), keeps the log
# and .buildinfo in $YOHANE_LOGS/STAGE/, deletes the build tree and outputs, and
# prints one result line last:
#   RESULT <ok|fail|hang|error> <seconds> <failstage> <log path>
# Stage "stage0" is the glibc reference rebuild: architecture-dependent
# binaries only (Architecture: all is imported, not rebuilt), with the
# package's own build-time tests on. Nothing from stage0 is published.
# Stage "stage0p" is the same with Yohane's patches applied (packages/<source>/).
# Needs ~/aqours/env (YOHANE_CHROOT, YOHANE_SCRATCH, YOHANE_LOGS, SBUILD_CONFIG, ...).
set -uo pipefail
STAGE=${1:?usage: buildone STAGE SOURCE VERSION}; SRC=${2:?}; VER=${3:?}

# Builds are started detached from a short SSH command. Their inherited session
# keyring belongs to that SSH login, and PAM (pam_keyinit "force revoke")
# revokes it when the login ends, so tests that use the session keyring (krb5's
# t_cccol.py) would fail. Run every build in a fresh anonymous session keyring.
if [ -z "${YOHANE_OWN_KEYRING:-}" ] && command -v keyctl >/dev/null; then
  export YOHANE_OWN_KEYRING=1
  exec keyctl session - "$0" "$@"
fi
. "$HOME/aqours/env"
: "${YOHANE_LOGS:?set YOHANE_LOGS}" "${YOHANE_CHROOT:?}" "${YOHANE_SCRATCH:?}"

# Sources whose build trees don't fit in RAM scratch build on local disk.
case "$SRC" in
  gcc-1[0-9]|glibc|llvm-toolchain-*|rustc|rust-*|linux|firefox-esr|thunderbird|libreoffice|openjdk-*|qtwebengine-*|chromium|webkit2gtk|mesa|python3.1[0-9]|binutils|systemd|perl)
    export YOHANE_SCRATCH=${YOHANE_SCRATCH_DISK:-$YOHANE_SCRATCH};;
esac
# The slots reservation. Most builds spend long stretches single-threaded
# (configure, tests, packaging), so ordinary sources reserve a small share and
# the queue packs more of them per host; only the giants reserve a lot.
case "$SRC" in
  rust-*|rustc|llvm-toolchain-*|gcc-1[0-9]|glibc|linux|libreoffice|firefox-esr|chromium) SIZE=L;;
  binutils|systemd|perl|python3.1[0-9]|openssl|util-linux|gnutls28|krb5|bind9|vim|grub2|elfutils|gnupg2|apparmor|exim4|openssh) SIZE=M;;
  *) SIZE=S;;
esac

work="$HOME/aqours/out/$STAGE/${SRC}_${VER}"
logdir="$YOHANE_LOGS/$STAGE"
rm -rf "$work"; mkdir -p "$work" "$logdir"
rm -f "$logdir/${SRC}_${VER}.result"
cd "$work" || exit 1

case "$STAGE" in
  stage0)  opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=no;;   # pure baseline: Devuan as is
  stage0p) opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=yes;;  # baseline + Yohane patches (glibc)
  # Stage 1 (decision 12): built in the chroot with libniji swapped in, tests on,
  # Yohane patches applied; outputs gated (tools/elfgate) and staged for the
  # "bootstrap" suite.
  stage1)  opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=yes
           export YOHANE_CHROOT=${YOHANE_CHROOT_STAGE1:?set YOHANE_CHROOT_STAGE1};;
  # Stage 1u: the tool-usage inventory pass (for nijicore). Built as stage 1, but in a root where
  # every process logs its CPU time when it exits (tools/usage); the per-program totals go into the
  # build log as YOHANE-USAGE lines. Nothing is gated, retried without tests, or published.
  # The report runs from sbuild's cleanup hook, and also from its build-failed hook, because sbuild
  # skips the cleanup hook's output when a build fails (the aggregator reads the first report only).
  stage1u) opts=(--no-arch-all --arch-any --chroot-cleanup-commands=/usr/lib/yohane-usage-report
                 --build-failed-commands=/usr/lib/yohane-usage-report)
           dbo="noautodbgsym"; patches=yes
           export YOHANE_CHROOT=${YOHANE_CHROOT_STAGE1U:?set YOHANE_CHROOT_STAGE1U};;
  # Stages 2 and 3 (design section 4): built as stage 1, but in a root whose every binary comes from
  # Yohane's own archive (tools/mkchroot --yohane-only): stage 2 from the bootstrap suite (stage 1's
  # output), stage 3 from unstable (stage 2's output), each with libniji's own headers. Outputs are gated
  # and staged like stage 1's; the driver's publish map says which suite they go to.
  stage2)  opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=yes
           export YOHANE_CHROOT=${YOHANE_CHROOT_STAGE2:?set YOHANE_CHROOT_STAGE2};;
  stage3)  opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=yes
           export YOHANE_CHROOT=${YOHANE_CHROOT_STAGE3:?set YOHANE_CHROOT_STAGE3};;
  *) echo "RESULT error 0 - unknown-stage"; exit 2;;
esac
# The stages that build what may be published: tests on (nocheck for T2), retry without tests, gate, staging.
case "$STAGE" in stage1|stage2|stage3) bootstrap_stage=yes;; *) bootstrap_stage=no;; esac
# Yohane versions its own builds from stage 2 on (decision 26; design section 3): binNMU style, the source
# unchanged and "+yohane1" appended to every binary's version. Stages 2 and 3 use the same suffix and the same
# fixed changelog timestamp (it becomes SOURCE_DATE_EPOCH), so their outputs can be compared byte for byte.
case "$STAGE" in
  stage2|stage3)
    opts+=(--append-to-version="${YOHANE_VERSION_SUFFIX:-+yohane1}"
           --binNMU-timestamp="${YOHANE_BINNMU_TIMESTAMP:-1795564800}"   # 2026-11-25 00:00:00 UTC
           --maintainer="Yohane Linux Maintainers <aqours@koiren.ai>");;
esac

# Yohane patches: packages/<source>/patches/*.patch from the Yohane repository,
# applied in name order to the verified Devuan source, then the build dependencies
# listed in packages/<source>/drop-build-deps removed from debian/control by
# tools/trimcontrol (decisions 16 and 24; the same rule tools/builddeps resolves
# with). The result is rebuilt as a new source package with version
# <version>yohane<N> (N from packages/<source>/revision, default 1), and that is
# what sbuild builds.
target="${SRC}_${VER}"
pkgdir="${YOHANE_PACKAGES:-}/$SRC"
if [ "$patches" = yes ] && [ -n "${YOHANE_PACKAGES:-}" ] \
   && { ls "$pkgdir"/patches/*.patch >/dev/null 2>&1 || [ -s "$pkgdir/drop-build-deps" ]; }; then
  prep="$logdir/${SRC}_${VER}.prep.log"
  rev=$(cat "$pkgdir/revision" 2>/dev/null || echo 1)
  newver="${VER}yohane${rev}"
  (
    set -e
    echo "== getsource $SRC $VER"
    dsc=$(python3 -I "$HOME/aqours/tools/getsource" "$SRC" "$VER" "$work/src")
    cd "$work/src"
    dpkg-source --no-check -x "$dsc" tree      # the .dsc's files were verified by getsource
    what=""
    for p in "$pkgdir"/patches/*.patch; do
      [ -e "$p" ] || continue
      echo "== apply $(basename "$p")"
      patch -p1 -d tree --no-backup-if-mismatch < "$p"
      what="$what $(basename "$p")"
    done
    if [ -s "$pkgdir/drop-build-deps" ]; then
      echo "== trim build dependencies: $(tr -s ' \n' ' ' < "$pkgdir/drop-build-deps")"
      python3 -I "$HOME/aqours/tools/trimcontrol" tree/debian/control "$pkgdir/drop-build-deps"
      what="$what drop-build-deps($(tr -s ' \n' ' ' < "$pkgdir/drop-build-deps" | sed 's/ $//'))"
    fi
    (cd tree && DEBEMAIL="aqours@koiren.ai" DEBFULLNAME="Yohane Linux Maintainers" \
      dch --newversion "$newver" --distribution excalibur --force-distribution \
          "Yohane: apply packages/$SRC:$what")
    dpkg-source --auto-commit -b tree
  ) > "$prep" 2>&1
  prc=$?
  target="$work/src/${SRC}_${newver#*:}.dsc"
  if [ $prc -ne 0 ] || [ ! -f "$target" ]; then
    zstd -q -f "$prep" -o "$prep.zst" && rm -f "$prep"
    cd /; rm -rf "$work"
    line="RESULT fail 0 yohane-patch $prep.zst"
    echo "$line" > "$logdir/${SRC}_${VER}.result"; echo "$line"; exit 0
  fi
  zstd -q -f "$prep" -o "$prep.zst" && rm -f "$prep"   # keep the record of what was applied
  cd "$work"
fi
jobs=${YOHANE_JOBS:-8}
case "$SIZE" in S) jobs=$(( (jobs + 1) / 2 ));; L) jobs=$((jobs * 2));; esac
export DEB_BUILD_OPTIONS="parallel=$jobs $dbo"
# Build profiles: those Yohane declares for this source (packages/<source>/build-profiles,
# e.g. nodoc; decision 14), from stage0p on, plus, during the bootstrap (decision 15),
# nodoc for every stage 1 build and nocheck for sources listed in $YOHANE_NOCHECK_LIST
# (T2, the packages needed only to build others). The pure stage 0 baseline uses none.
profiles=""
# (Carriage returns are dropped: a CRLF file once made every profile name end in \r, and sbuild matched none.)
[ "$patches" = yes ] && [ -s "$pkgdir/build-profiles" ] && profiles=$(tr -d '\r' < "$pkgdir/build-profiles" | tr -s ' \n' ' ')
if [ "$bootstrap_stage" = yes ] || [ "$STAGE" = stage1u ]; then
  profiles="$profiles nodoc"
  [ -n "${YOHANE_NOCHECK_LIST:-}" ] && grep -qx "$SRC" "$YOHANE_NOCHECK_LIST" 2>/dev/null && profiles="$profiles nocheck"
fi
profiles=$(echo $profiles | tr ' ' '\n' | sort -u | tr '\n' ',' | sed 's/^,//; s/,$//')
# A stage 1 source that declares packages/<source>/stage1-bootstrap-repo resolves its build dependencies with
# Yohane's bootstrap suite added (at $YOHANE_ARCHIVE). It is for sources whose build dependency exists only as a
# Yohane build in stage 1 (systemd: Debian's needs glibc 2.41); without it they would wait for stage 2, and the
# stage 2 root, which holds only stage 1 output, would lack their binaries.
# The file lists the binary packages to take from bootstrap; they are pinned to it, because Yohane's build of
# systemd has the same version as Debian's, and apt would otherwise pick either.
if [ "$STAGE" = stage1 ] && [ -e "$pkgdir/stage1-bootstrap-repo" ]; then
  opts+=(--extra-repository="deb ${YOHANE_ARCHIVE:?set YOHANE_ARCHIVE (Yohane archive URL)} bootstrap main")
  pinned=$(grep -v '^#' "$pkgdir/stage1-bootstrap-repo" | tr -s ' \n' ' ' | sed 's/^ //; s/ $//')
  if [ -n "$pinned" ]; then
    pf=/etc/apt/preferences.d/yohane-bootstrap
    # The root already has Devuan's build of some of them (libsystemd0) at the same version; replacing it with
    # Yohane's counts as a downgrade to apt, which sbuild's apt-get -y refuses, so allow it for this build.
    opts+=(--chroot-setup-commands="echo 'Package: $pinned' > $pf; echo 'Pin: release n=bootstrap' >> $pf; echo 'Pin-Priority: 990' >> $pf; echo 'APT::Get::Allow-Downgrades \"true\";' > /etc/apt/apt.conf.d/99yohane-bootstrap")
  fi
fi
if [ -n "$profiles" ]; then
  opts+=(--profiles="$profiles")
  export DEB_BUILD_PROFILES="${profiles//,/ }"
  case " $DEB_BUILD_PROFILES " in *" nodoc "*) DEB_BUILD_OPTIONS="$DEB_BUILD_OPTIONS nodoc";; esac
  case " $DEB_BUILD_PROFILES " in *" nocheck "*) DEB_BUILD_OPTIONS="$DEB_BUILD_OPTIONS nocheck";; esac
fi
# slots caps a shared job's run time (SLOT_MAX_MIN, default 150 minutes), and
# gcc or binutils with their test suites run longer. Our own backstop below is
# the only time limit, so lift the queue's cap just above it.
backstop_h=${YOHANE_BUILD_BACKSTOP_H:-8}
# gcc's test suite runs in three configurations (default, -fstack-protector,
# -m32) and takes far longer than any other package; give it its own backstop.
case "$SRC" in gcc-1[0-9]) backstop_h=${YOHANE_GCC_BACKSTOP_H:-24};; esac
# slots pins each job to a block of cores (it serves timing runs too). Builds
# need no pinning, and some test suites assume CPU 0 is in their affinity mask
# (libuv's thread_affinity), so pinning makes results depend on which block a
# job got. A no-op pin helper leaves builds unpinned; the queue still counts cores.
export SLOT_PIN_BIN=/bin/true

# One sbuild run. Sets: rc, log, failstage, status, secs, res. $1 = extra DEB_BUILD_OPTIONS.
run_sbuild() {
  local start=$SECONDS
  rm -f "$work"/*.build "$work"/*.changes "$work"/*.deb "$work"/*.buildinfo
  DEB_BUILD_OPTIONS="$DEB_BUILD_OPTIONS ${1:-}" \
  SLOT_MAX_MIN=$(( backstop_h * 60 + 15 )) SLOT_SIZE=$SIZE "$HOME/bin/slots" 1 "yohane:$STAGE:$SRC" \
    timeout --kill-after=5m "${backstop_h}h" \
    sbuild --chroot="$YOHANE_CHROOT" --dist=excalibur "${opts[@]}" "$target" >/dev/null 2>&1
  rc=$?
  secs=$((SECONDS - start))
  log=$(ls -t "$work"/*.build 2>/dev/null | grep -v '_amd64.build$' | head -1)
  [ -n "$log" ] || log=$(ls -t "$work"/*.build 2>/dev/null | head -1)
  failstage=$(grep -a -m1 '^Fail-Stage:' "$log" 2>/dev/null | awk '{print $2}')
  # sbuild's own job time (Package-Time), not wall time, which also counts queue waits.
  local ptime; ptime=$(grep -a -m1 '^Package-Time:' "$log" 2>/dev/null | awk '{print $2}')
  [ -n "$ptime" ] && secs=$ptime
  status=$(grep -a -m1 '^Status:' "$log" 2>/dev/null | awk '{print $2}')
  if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then res=hang
  elif [ "$status" = successful ] && [ $rc -eq 0 ]; then res=ok
  elif [ -n "$log" ]; then res=fail
  else res=error; fi
}

dest="$logdir/${SRC}_${VER}.log.zst"
run_sbuild
[ -n "$log" ] && zstd -q -f -19 "$log" -o "$dest"

# Stage 1: a failure in the build step (where the package's own tests run) is a
# finding; keep its log as .check.log.zst and build once more with nocheck, so
# the bootstrap can proceed. Result "oknc" = built, but its tests failed on libniji.
if [ "$bootstrap_stage" = yes ] && [ "$res" = fail ] && [ "${failstage:-}" = build ] \
   && [[ ",$profiles," != *",nocheck,"* ]]; then
  mv -f "$dest" "$logdir/${SRC}_${VER}.check.log.zst"
  first_secs=$secs
  run_sbuild nocheck
  [ -n "$log" ] && zstd -q -f -19 "$log" -o "$dest"
  if [ "$res" = ok ]; then res=oknc; failstage=check; fi
  secs=$((secs + first_secs))
fi
# For "oknc", the finding is in the first (with-tests) log; report that one.
report_log=$dest
[ "$res" = oknc ] && report_log="$logdir/${SRC}_${VER}.check.log.zst"
cp -f "$work"/*.buildinfo "$logdir/" 2>/dev/null

# Gate and staging (stage 1 for the bootstrap suite, stages 2 and 3 for the suites the driver maps them to).
if [ "$bootstrap_stage" = yes ] && { [ "$res" = ok ] || [ "$res" = oknc ]; }; then
  allowed="${YOHANE_CHROOT%.tar.zst}.allowed-2.4x"
  if [ ! -s "$allowed" ]; then
    # The GLIBC_2.40/2.41 symbols the chroot's libniji libc.so.6 defines.
    t=$(mktemp -d); tar --zstd -C "$t" -xf "$YOHANE_CHROOT" ./usr/lib/x86_64-linux-gnu/ 2>/dev/null
    readelf --dyn-syms -W "$(readlink -f "$t/usr/lib/x86_64-linux-gnu/libc.so.6" || echo "$t/usr/lib/x86_64-linux-gnu/libc.so.6")" 2>/dev/null \
      | awk '$7 != "UND" && $8 ~ /@GLIBC_2\.4[01]$/ { sub(/@@?/, "@", $8); print $8 }' | sort -u > "$allowed.tmp"
    mv -f "$allowed.tmp" "$allowed"; rm -rf "$t"
  fi
  gatelog="$logdir/${SRC}_${VER}.gate.log"
  if "$HOME/aqours/tools/elfgate" "$allowed" "$work"/*.deb > "$gatelog" 2>&1; then
    stagedir="${YOHANE_INCOMING:?set YOHANE_INCOMING}/$STAGE/${SRC}_${VER}"
    rm -rf "$stagedir"; mkdir -p "$stagedir"
    changes=$(ls "$work"/*.changes | head -1)
    cp "$changes" $(sed -n '/^Files:/,$p' "$changes" | awk 'NF==5{print "'"$work"'/"$5}') "$stagedir"/
  else
    res=fail; failstage=yohane-gate
    zstd -q -f "$gatelog" -o "$gatelog.zst" && rm -f "$gatelog"; report_log="$gatelog.zst"
  fi
  [ -f "$gatelog" ] && { zstd -q -f "$gatelog" -o "$gatelog.zst"; rm -f "$gatelog"; }
fi

cd /; rm -rf "$work"
line="RESULT $res $secs ${failstage:--} $report_log"
# Also leave the result beside the log, so a restarted driver can pick it up.
echo "$line" > "$logdir/${SRC}_${VER}.result.tmp" && mv -f "$logdir/${SRC}_${VER}.result.tmp" "$logdir/${SRC}_${VER}.result"
echo "$line"
