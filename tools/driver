#!/usr/bin/python3 -I
"""driver: queue and dispatch Yohane builds to the build hosts, and record results.

    tools/driver enqueue STAGE LISTFILE     add "source version" lines as queued jobs
    tools/driver run STAGE                  dispatch until the stage's queue is empty
    tools/driver status [STAGE]             counts and the failures so far
    tools/driver failures STAGE             failed jobs with their failure stage and log
    tools/driver resig STAGE                recompute failure signatures (after changing the rule)

Settings come from ~/aqours/driver.conf (JSON):
  {"db": ".../yohane.db", "events": ".../events.log",
   "hosts": {"hostA": {"ssh": "user@hostA", "max": 4}, "hostB": {..., "stages": ["stage2"]}, ...},
   "publish": {"stage1": "bootstrap"}, "incoming": "...", "reprepro": "...", "gnupghome": "..."}
A stage listed under "publish" has its successful builds (status ok, or oknc:
built but its tests failed) included into that suite from the incoming
directory, signed on this host. With "ledger": {"tool", "repo", "as"}, every
host is checked against the shared resource ledger before a build is started
there; during a maintenance window it gets no new builds.

Operating rules (learned by libniji, adopted by Yohane):
  - No retries: a failure is a result, recorded once. Requeue by hand after a fix.
  - Systemic detector: when the same failure signature hits 3 or more different
    sources, dispatch stops and an event is raised. Fix the shared cause first.
    A cause that is understood and has a planned fix can be acknowledged in the
    "acknowledged-signatures" file next to the database (regex, TAB, reason);
    its failures are still recorded but no longer stop the line.
  - The build host's slots queue decides what fits on its cores; the driver only
    keeps up to "max" jobs outstanding per host.
  - Large sources are dispatched first so they don't straggle at the end.
  - Notable events (stage done, systemic stop, host trouble) are appended to the
    events file, one line per condition.
  - Restartable: a new driver adopts builds an earlier one left running (each
    build leaves a .result file beside its log). Creating STOP or STOP-<stage>
    next to the database pauses dispatch; running builds finish.
"""
import json, os, re, sqlite3, subprocess, sys, threading, time

CONF = os.path.expanduser(os.environ.get("YOHANE_DRIVER_CONF", "~/aqours/driver.conf"))
# The job status this driver dispatches from. Normally "queued"; a different
# value lets a new driver take over a queue while an older one still finishes
# its own builds (the older one only ever looks at "queued").
QSTATUS = os.environ.get("YOHANE_QUEUE_STATUS", "queued")
BIG = re.compile(r"^(gcc-1\d|glibc|llvm-toolchain-.*|rustc|rust-.*|linux|binutils|systemd|perl|python3\.1\d|"
                 r"openssl|util-linux|gnutls28|krb5|bind9|vim|grub2|elfutils|gnupg2|apparmor|exim4|openssh)$")
SYSTEMIC = 3

# Builds finish on several worker threads; reprepro takes an exclusive lock on its
# database and fails at once if another instance holds it, so publishes run one at a time.
_publish_lock = threading.Lock()


def conf():
    with open(CONF) as f:
        return json.load(f)


def db(c):
    con = sqlite3.connect(c["db"], timeout=60, isolation_level=None)
    con.execute("""create table if not exists jobs(
        stage text, source text, version text, status text, host text,
        queued real, started real, finished real, secs integer,
        failstage text, signature text, log text,
        primary key(stage, source, version))""")
    return con


def event(c, line):
    with open(c["events"], "a") as f:
        f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + " DRIVER " + line + "\n")


def enqueue(stage, listfile):
    c = conf(); con = db(c); n = 0
    for line in open(listfile):
        parts = line.split()
        if len(parts) >= 2:
            cur = con.execute("insert or ignore into jobs(stage,source,version,status,queued) values(?,?,?,?,?)",
                              (stage, parts[0], parts[1], "queued", time.time()))
            n += cur.rowcount
    print(f"enqueued {n} new jobs for {stage}")


def signature(failstage, logpath, host):
    """A coarse failure signature: the failing stage plus the first error-looking line."""
    if not logpath or logpath == "-":
        return failstage or "nolog"
    if failstage == "install-deps":
        # Name the build dependency that can't be installed, not apt's generic line.
        try:
            out = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                                  f"zstdcat {logpath} | grep -a -m1 -oE 'Depends: [^ ]+( \\([^)]*\\))? but [a-z ]+' "
                                  "| cut -c1-160"], capture_output=True, text=True, timeout=60).stdout.strip()
        except Exception:
            out = ""
        if out:
            return f"install-deps: {out}"
    # The first line that names the actual failure: a debhelper error, a compiler
    # error, a test-suite FAIL, or an sbuild E: line other than the generic
    # "Build failure". Anchored, because sbuild's preamble has lines like
    # "I: NOTICE: ..." that loose patterns match in every log.
    pattern = r"(^GATE FAIL |^dh_[a-z_]+: error:|: (fatal )?error:|^FAIL: |^E: |^make(\[[0-9]+\])?: \*\*\*|^ld\.so: )"
    try:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                              f"zstdcat {logpath} | grep -a -E '{pattern}' | grep -av -e 'E: Build failure' "
                              "-e 'dpkg-buildpackage: error' -e 'make: \\*\\*\\* \\[debian/rules' | head -1 "
                              "| sed -E 's/[0-9]+/N/g; s#/[^ ]*/#/…/#g' | cut -c1-160"],
                             capture_output=True, text=True, timeout=60).stdout.strip()
    except Exception:
        out = ""
    return f"{failstage}: {out}" if out else (failstage or "unknown")


RESULT_RE = re.compile(r"^RESULT (\S+) (\d+) (\S+) (\S+)$", re.M)


def record(c, con, stage, h, src, ver, text, stop):
    """Record a RESULT line for a job; returns the failure signature (None if ok)."""
    m = RESULT_RE.search(text or "")
    if m:
        res, secs, fstage, log = m.group(1), int(m.group(2)), m.group(3), m.group(4)
    else:
        res, secs, fstage, log = "error", 0, "-", "-"
    sig = None if res == "ok" else signature(fstage, log, c["hosts"][h]["ssh"])
    if res in ("ok", "oknc") and stage in c.get("publish", {}):
        with _publish_lock:
            res = publish(c, stage, src, ver) or res
    con.execute("update jobs set status=?, host=?, finished=?, secs=?, failstage=?, signature=?, log=? "
                "where stage=? and source=? and version=?",
                (res, h, time.time(), secs, fstage, sig, log, stage, src, ver))
    print(f"{time.strftime('%H:%M:%S')} {h:6} {res:5} {secs:6}s {src} {ver}" + (f"  [{sig}]" if sig else ""),
          flush=True)
    if sig and not acknowledged(sig):
        # Blocked jobs are triaged (a note says why), so they no longer count towards a systemic stop.
        n = con.execute("select count(distinct source) from jobs where stage=? and signature=? and status != 'blocked'",
                        (stage, sig)).fetchone()[0]
        if n >= SYSTEMIC and not stop.is_set():
            stop.set()
            event(c, f"systemic-stop {stage}: signature hit {n} sources: {sig}")
    return sig


def publish(c, stage, src, ver):
    """Include a staged build into the stage's suite (conf "publish": {stage: suite}).

    Runs on this (the coordination) host, which holds the signing key. Returns
    None on success, or "publish-failed" (and raises an event) otherwise."""
    suite = c["publish"][stage]
    d = os.path.join(c["incoming"], stage, f"{src}_{ver}")
    changes = [f for f in (os.listdir(d) if os.path.isdir(d) else []) if f.endswith(".changes")]
    if len(changes) != 1:
        event(c, f"publish-failed {stage}: {src} {ver}: expected one .changes in {d}, found {len(changes)}")
        return "publish-failed"
    env = dict(os.environ, GNUPGHOME=c["gnupghome"])
    p = subprocess.run(["reprepro", "-b", c["reprepro"], "--waitforlock=360", "--ignore=wrongdistribution", "include", suite,
                        os.path.join(d, changes[0])], capture_output=True, text=True, env=env)
    if p.returncode != 0:
        event(c, f"publish-failed {stage}: {src} {ver} into {suite}: " + (p.stderr.strip().splitlines() or ["?"])[-1][:200])
        return "publish-failed"
    subprocess.run(["rm", "-rf", d])
    return None


def acknowledged(sig):
    """True when sig matches a line of the acknowledged-signatures file next to the db.

    Each non-comment line is "regex<TAB>reason". An acknowledged signature is a
    shared cause that is understood and has a planned fix; its failures are still
    recorded, but they don't stop the line."""
    path = os.path.join(os.path.dirname(conf()["db"]), "acknowledged-signatures")
    try:
        for line in open(path):
            line = line.rstrip("\n")
            if line and not line.startswith("#") and re.search(line.split("\t")[0], sig):
                return True
    except OSError:
        pass
    return False


_ledger_cache = {}


def host_available(c, h):
    """Ask the shared resource ledger whether this project may use host h now.

    Configured by conf "ledger": {"tool": ".../resource.py", "repo": "...", "as": "<project>"}.
    The owner's maintenance windows override every claim, so a host in maintenance
    (or no longer ours) gets no new builds; running builds are not touched. The
    answer is cached for 60 s. If the check itself fails, the host is treated as
    unavailable, so a broken check can never let builds run through a window."""
    led = c.get("ledger")
    if not led:
        return True
    now = time.time()
    hit = _ledger_cache.get(h)
    if hit and now - hit[0] < 60:
        return hit[1]
    try:
        p = subprocess.run(["python3", "-I", led["tool"], "check", h, "--as", led["as"]],
                           cwd=led["repo"], capture_output=True, text=True, timeout=120)
        ok, why = p.returncode == 0, (p.stdout + p.stderr).strip().splitlines()[-1:] or ["?"]
    except Exception as e:
        ok, why = False, [f"check failed: {e}"]
    prev = hit[1] if hit else True
    _ledger_cache[h] = (now, ok)
    if prev != ok:
        event(c, f"host-{'available' if ok else 'unavailable'} {h}: ledger says: {why[0][:160]}")
    return ok


def stop_requested(stage):
    d = os.path.dirname(conf()["db"])
    return os.path.exists(os.path.join(d, "STOP")) or os.path.exists(os.path.join(d, "STOP-" + stage))


def run(stage):
    c = conf()
    # A host with "stages": [...] only takes builds of those stages (it may have no root for the others).
    hosts = {h: v for h, v in c["hosts"].items() if stage in v.get("stages", [stage])}
    lock = threading.Lock()
    stop = threading.Event()
    outstanding = {h: 0 for h in hosts}
    logs = c.get("logs", "")
    buildone_path = c.get("buildone", "/home/claude/aqours/tools/buildone")

    def adopt(h, src, ver):
        """Wait for a build started by an earlier driver: poll its result file on the host."""
        ssh = hosts[h]["ssh"]; con = db(c)
        rfile = f"{logs}/{stage}/{src}_{ver}.result"
        try:
            while True:
                # Fixed-string match on the command line: versions contain regex
                # metacharacters ("+"), so pgrep -f would miss a running build.
                p = subprocess.run(["ssh", "-o", "BatchMode=yes", ssh,
                                    f"cat '{rfile}' 2>/dev/null || (ps -eo args | grep -qxF "
                                    f"'/bin/bash {buildone_path} {stage} {src} {ver}' && echo RUNNING || echo GONE)"],
                                   capture_output=True, text=True)
                if p.returncode == 255:      # ssh itself failed: the host is unreachable, not the build gone
                    time.sleep(60); continue
                out = p.stdout.strip()
                if out.startswith("RESULT"):
                    record(c, con, stage, h, src, ver, out, stop); return
                if out == "GONE":
                    con.execute("update jobs set status=?, host=null, started=null where stage=? and source=? "
                                "and version=?", (QSTATUS, stage, src, ver))
                    event(c, f"lost-build {stage}: {src} {ver} on {h} ended without a result; requeued")
                    return
                time.sleep(60)
        finally:
            with lock:
                outstanding[h] -= 1

    # Adopt builds an earlier driver left running.
    threads = []
    for src, ver, h in db(c).execute("select source, version, host from jobs where stage=? and status='running'",
                                     (stage,)).fetchall():
        if h in hosts and logs:
            outstanding[h] += 1
            t = threading.Thread(target=adopt, args=(h, src, ver), daemon=True); t.start(); threads.append(t)
            print(f"adopting {src} {ver} on {h}", flush=True)

    def next_job():
        con = db(c)
        rows = con.execute("select source, version from jobs where stage=? and status=?", (stage, QSTATUS)).fetchall()
        if not rows:
            return None
        rows.sort(key=lambda r: (0 if BIG.match(r[0]) else 1, r[0]))
        src, ver = rows[0]
        con.execute("update jobs set status='running', secs=null, failstage=null, signature=null, started=? where stage=? and source=? and version=?",
                    (time.time(), stage, src, ver))
        return src, ver

    def worker(h, src, ver):
        """Start the build detached on the host, then wait for its result file.

        The build never depends on this driver's SSH session or process: a
        driver restart (or a dropped connection) can't kill it, and the next
        driver adopts it."""
        ssh = hosts[h]["ssh"]
        con = db(c)
        con.execute("update jobs set host=? where stage=? and source=? and version=?", (h, stage, src, ver))
        p = subprocess.run(["ssh", "-n", "-o", "BatchMode=yes", ssh,
                            f"setsid nohup {buildone_path} {stage} {src} {ver} >/dev/null 2>&1 < /dev/null &"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            event(c, f"host-trouble {h}: could not start {src} {ver} (ssh exit {p.returncode}): "
                     + (p.stderr.strip().splitlines() or ["-"])[-1][:200])
            con.execute("update jobs set status=?, host=null, started=null where stage=? and source=? and version=?",
                        (QSTATUS, stage, src, ver))
            with lock:
                outstanding[h] -= 1
            return
        time.sleep(30)          # let buildone clear any stale result file before the first poll
        adopt(h, src, ver)      # polls the result file; releases the host's count when done

    while not stop.is_set():
        if stop_requested(stage):
            event(c, f"stop-requested {stage}: dispatch paused; running builds will finish")
            stop.set(); break
        launched = False
        with lock:
            for h in hosts:
                if outstanding[h] < hosts[h]["max"] and host_available(c, h):
                    job = next_job()
                    if job is None:
                        break
                    outstanding[h] += 1
                    t = threading.Thread(target=worker, args=(h, *job), daemon=True)
                    t.start(); threads.append(t); launched = True
        with lock:
            busy = sum(outstanding.values())
        if not launched and busy == 0:
            break
        time.sleep(5)
    for t in threads:
        t.join()
    con = db(c)
    counts = dict(con.execute("select status, count(*) from jobs where stage=? group by status", (stage,)).fetchall())
    event(c, f"stage-{'stopped' if stop.is_set() else 'done'} {stage}: " +
          ", ".join(f"{k}={v}" for k, v in sorted(counts.items())))
    print("finished:", counts)


def status(stage=None):
    c = conf(); con = db(c)
    q = "select stage, status, count(*), sum(secs) from jobs" + (" where stage=?" if stage else "") + \
        " group by stage, status order by stage, status"
    for row in con.execute(q, (stage,) if stage else ()):
        print(f"{row[0]:10} {row[1]:8} {row[2]:5}  {(row[3] or 0) / 3600:7.1f} build-hours")


def resig(stage):
    """Recompute the failure signatures of a stage's failed jobs (after a signature fix)."""
    c = conf(); con = db(c); hosts = c["hosts"]
    for src, ver, host, fstage, log in con.execute(
            "select source, version, host, failstage, log from jobs where stage=? and status in ('fail','hang')",
            (stage,)).fetchall():
        sig = signature(fstage, log, hosts[host]["ssh"])
        con.execute("update jobs set signature=? where stage=? and source=? and version=?", (sig, stage, src, ver))
        print(f"{src} {ver}: {sig}")


def failures(stage):
    c = conf(); con = db(c)
    for row in con.execute("select source, version, status, host, failstage, signature, log from jobs "
                           "where stage=? and status in ('fail','hang','error','oknc','publish-failed') order by source", (stage,)):
        print(" | ".join(str(x) for x in row))


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["enqueue"] and len(a) == 3: enqueue(a[1], a[2])
    elif a[:1] == ["run"] and len(a) == 2: run(a[1])
    elif a[:1] == ["status"]: status(a[1] if len(a) > 1 else None)
    elif a[:1] == ["failures"] and len(a) == 2: failures(a[1])
    elif a[:1] == ["resig"] and len(a) == 2: resig(a[1])
    else: print(__doc__); sys.exit(2)
